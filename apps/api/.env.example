# Plantilla de configuración de la API. Copie a `.env` (no versionado) y complete los valores.
# No escriba secretos reales en este archivo.

APP_ENV=development
LOG_LEVEL=INFO

# Base de datos. El usuario de conexión debe poder hacer SET ROLE al rol de aplicación.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/portal_test
DATABASE_APP_ROLE=portal_app

# Supabase Auth. Pendiente: sin proyecto configurado la API responde 503 en rutas protegidas.
# Use SUPABASE_JWT_SECRET (HS256) o SUPABASE_JWKS_URL (RS256/ES256), no ambos.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
JWT_LEEWAY_SECONDS=30

# Orígenes permitidos para el navegador, en formato JSON. Nunca "*".
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Documentación OpenAPI. En production se desactiva salvo que se active explícitamente.
DOCS_ENABLED=true


# Agente Logix (OpenRouter). DESACTIVADO por defecto. Solo FastAPI usa estas variables: nunca React,
# nunca build args de Docker, nunca un archivo versionado. Los modelos se fijan tras verificarlos
# (disponibilidad, precio, herramientas, privacidad y dimensiones de embeddings): ver docs/logix-arquitectura.md.
LOGIX_AI_ENABLED=false
LOGIX_RAG_ENABLED=false
# Autorización empresarial para enviar datos del portal a OpenRouter. Sin "true" no se puede activar Logix.
LOGIX_EXTERNAL_PROCESSING_AUTHORIZED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=
# Límites: contexto, salida, tiempo por llamada, solicitudes por usuario y presupuesto diario (USD).
LOGIX_MAX_INPUT_TOKENS=4000
LOGIX_MAX_OUTPUT_TOKENS=800
LOGIX_TIMEOUT_SECONDS=20
LOGIX_MAX_REQUESTS_PER_USER_PER_HOUR=30
LOGIX_DAILY_BUDGET_USD=5
LOGIX_MAX_RETRIEVED_CHUNKS=6

# Supabase Storage (documentos de operación). La clave privilegiada SOLO la usa FastAPI: no la ponga en el frontend,
# en build args de Docker ni en archivos versionados. Sin ella, las rutas de documentos responden 503.
SUPABASE_SECRET_KEY=
STORAGE_SIGNED_URL_SECONDS=300
