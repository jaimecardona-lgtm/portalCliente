# Variables públicas del frontend (Vite). Se copian a apps/web/.env.local (no versionado).
# Todo lo que empieza por VITE_ se incluye en el navegador: aquí nunca va una clave secreta.

# Modo de acceso. Vacío en desarrollo = presentación local con datos sintéticos (no hay datos reales).
# "supabase" = acceso real con Supabase Auth y la API de FastAPI.
VITE_AUTH_PROVIDER=

# Mismo origen en Docker ("/api/v1"). En desarrollo con la API en otro puerto: http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=/api/v1

# Clave PUBLICABLE del proyecto (sb_publishable_...). El build rechaza claves sb_secret_ o service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
